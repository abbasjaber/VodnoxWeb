APP_NAME=VODNOX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vodnox
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Secure cookies in production (uncomment when serving over HTTPS)
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS - comma-separated list of allowed origins.
# Do NOT use "*" together with credentials (supports_credentials is false).
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# External integrations (placeholders; no real integrations in this phase)
INTEGRATION_HTTP_TIMEOUT=15
INTEGRATION_CONNECT_TIMEOUT=5
INTEGRATION_RETRY_TIMES=0
INTEGRATION_RETRY_SLEEP=100
INTEGRATION_LOG_CHANNEL=integrations

# Asterisk / AMI (deferred to a later phase)
ASTERISK_ENABLED=false
ASTERISK_HOST=127.0.0.1
ASTERISK_PORT=5038
ASTERISK_USERNAME=
ASTERISK_SECRET=

# ---------------------------------------------------------------------------
# Telephony provisioning (VODNOX -> Asterisk provisioning agent)
# See deploy/telephony/README.md. Never commit real secrets.
# ---------------------------------------------------------------------------
TELEPHONY_ENABLED=false

# Base URL of the provisioning agent (HTTPS, private network or VPN only).
TELEPHONY_PROVISIONING_URL=
# Bearer token the agent requires.
TELEPHONY_PROVISIONING_TOKEN=
# HMAC secret used to sign agent requests (timestamp.nonce.body).
TELEPHONY_PROVISIONING_SIGNING_SECRET=

# Webhook signing secret (HMAC-SHA256) for inbound call events. Empty until the
# server supplies it; inbound webhooks are rejected as "not configured" until then.
TELEPHONY_WEBHOOK_SECRET=

# Values handed to the browser (not secrets). The SIP password is delivered
# separately per user through an authenticated, no-store endpoint.
TELEPHONY_SIP_DOMAIN=pbx.vodnox.com
TELEPHONY_SIP_WSS_URL=wss://pbx.vodnox.com:8089/ws
TELEPHONY_SIP_ICE_URL=
# Optional TURN relay when STUN alone is not enough.
TELEPHONY_TURN_URL=
TELEPHONY_TURN_USERNAME=
TELEPHONY_TURN_CREDENTIAL=
TELEPHONY_CREDENTIAL_TTL=300

VITE_APP_NAME="${APP_NAME}"
