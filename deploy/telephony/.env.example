# ---------------------------------------------------------------------------
# VODNOX — application-side telephony settings (no secrets in this file).
#
# These are the values the Laravel app needs so its provisioning jobs can reach
# the agent on the media server. Copy the lines you need into the real .env and
# fill in the two secrets there; never commit the values themselves.
# ---------------------------------------------------------------------------

# Turn real telephony provisioning on (false keeps the simulated gateway).
TELEPHONY_ENABLED=false

# Base URL of the provisioning agent installed by deploy/telephony.
TELEPHONY_PROVISIONING_URL=https://pbx.vodnox.com

# Shared with deploy/telephony/provisioning/config.php -> 'token'.
TELEPHONY_PROVISIONING_TOKEN=

# Shared with deploy/telephony/provisioning/config.php -> 'signing_secret'.
# The name must stay TELEPHONY_PROVISIONING_SIGNING_SECRET: that is the key
# config/integrations.php reads, so the value actually reaches the gateway.
TELEPHONY_PROVISIONING_SIGNING_SECRET=

# Shared with the webhook controller: signs the call events Asterisk posts back.
TELEPHONY_WEBHOOK_SECRET=

# SIP identity the browser phone registers with.
TELEPHONY_SIP_DOMAIN=pbx.vodnox.com
TELEPHONY_SIP_WSS_URL=wss://pbx.vodnox.com:8089/ws
TELEPHONY_SIP_ICE_URL=stun:pbx.vodnox.com:3478

# TURN relay, only needed when employees are behind symmetric NAT.
TELEPHONY_TURN_URL=
TELEPHONY_TURN_USERNAME=
TELEPHONY_TURN_CREDENTIAL=

# How long a browser may keep fetched SIP credentials (seconds).
TELEPHONY_CREDENTIAL_TTL=3600
